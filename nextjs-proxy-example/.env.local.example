# Copy to .env.local in your Next.js project root and fill in.
# These are SERVER-ONLY (no NEXT_PUBLIC_ prefix) so they never reach the browser.

# Where the voice-clone backend is reachable from your website's SERVER.
VOICE_CLONE_URL=http://localhost:8000

# The API key your backend expects (from backend/.env -> VOICE_CLONE_API_KEYS).
VOICE_CLONE_API_KEY=vc_your_key_here
